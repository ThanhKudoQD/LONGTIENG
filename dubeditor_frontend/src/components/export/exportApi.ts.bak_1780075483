/**
 * exportApi — typed API client cho module Export Video.
 */
import api from '../../api'
import { ExportConfig, ExportJob, ExportPreset } from './types'

// ─── Jobs ───────────────────────────────────────────────────────────────────

export async function runExport(projectId: number, config: ExportConfig): Promise<ExportJob> {
  const r = await api.post(`/export_video/run/${projectId}`, { config })
  return normalizeJob(r.data)
}

export async function listJobs(projectId: number): Promise<ExportJob[]> {
  const r = await api.get(`/export_video/jobs/${projectId}`)
  return (r.data || []).map(normalizeJob)
}

export async function cancelJobApi(jobId: number): Promise<void> {
  await api.post(`/export_video/jobs/${jobId}/cancel`)
}

export async function deleteJob(jobId: number): Promise<void> {
  await api.delete(`/export_video/jobs/${jobId}`)
}

// ─── Upload ─────────────────────────────────────────────────────────────────

export interface UploadResult {
  url: string
  name: string
  size: number
  duration?: number
  width?: number
  height?: number
}

export async function uploadAsset(
  projectId: number,
  file: File,
  kind: 'audio' | 'image',
): Promise<UploadResult> {
  const form = new FormData()
  form.append('file', file)
  form.append('kind', kind)
  const r = await api.post(`/export_video/upload-asset/${projectId}`, form, {
    headers: { 'Content-Type': 'multipart/form-data' },
  })
  return r.data
}

// ─── Presets ────────────────────────────────────────────────────────────────

export async function listPresets(): Promise<ExportPreset[]> {
  const r = await api.get(`/export_video/presets`)
  return r.data || []
}

export async function createPreset(name: string, config: Partial<ExportConfig>): Promise<ExportPreset> {
  const r = await api.post(`/export_video/presets`, { name, config })
  return r.data
}

export async function deletePresetApi(presetId: number): Promise<void> {
  await api.delete(`/export_video/presets/${presetId}`)
}

// ─── Helpers ────────────────────────────────────────────────────────────────

function normalizeJob(j: any): ExportJob {
  return {
    id: j.id,
    project_id: j.project_id,
    status: j.status,
    progress_percent: j.progress || 0,
    config: j.config,
    output_path: j.output_path,
    output_url: j.output_url,
    error_msg: j.error_msg,
    created_at: j.created_at,
    finished_at: j.finished_at,
    estimated_remaining_sec: j.eta_sec || 0,
  }
}

// ─── Per-project config (v4.0 auto-save) ────────────────────────────────────

export async function getProjectConfig(projectId: number): Promise<Partial<ExportConfig> | null> {
  const r = await api.get(`/export_video/config/${projectId}`)
  return r.data?.config || null
}

export async function saveProjectConfig(projectId: number, config: ExportConfig): Promise<void> {
  await api.put(`/export_video/config/${projectId}`, { config })
}
