/**
 * ConfigPanel cho Simple Translator.
 *
 * Đơn giản hơn ConfigPanel cũ (8+ stages) — chỉ có 4 task cần cấu hình:
 *   - Bible       (heavy)
 *   - Translate   (heavy, main)
 *   - Repair      (medium)
 *   - QA          (medium, optional)
 *
 * Layout: modal full-screen overlay, 3 tab dọc:
 *   1. API keys + models (mỗi task chọn provider + model + thinking)
 *   2. Batch & validation (size, gap, concurrency, CPS max)
 *   3. Review & Repair (group config, retry, context adaptive)
 *
 * Lưu vào localStorage key 'simple_translate_config_v1'.
 */
import React, { useState, useEffect } from 'react'
import type { SimpleConfig, TaskKey, Provider } from './types'
import { MODELS, PROVIDER_LABELS, TASK_LABELS, DEFAULT_TASK_MODELS } from './modelCatalog'

const STORAGE_KEY = 'simple_translate_config_v1'

// ─── Default & storage helpers ──────────────────────────────────────────────

export function defaultSimpleConfig(): SimpleConfig {
  return {
    api_keys: { gemini: '', openai: '', deepseek: '' },
    tasks: {
      bible:     { ...DEFAULT_TASK_MODELS.bible },
      translate: { ...DEFAULT_TASK_MODELS.translate },
      qa:        { ...DEFAULT_TASK_MODELS.qa },
      retranslate: { ...DEFAULT_TASK_MODELS.retranslate },
    },
    batch_size_target: 100,
    batch_size_max: 120,
    gap_threshold_seconds: 3,
    previous_context_lines: 15,
    concurrency_mode: 'normal',
    turbo_concurrency: 5,
    cps_max: 22,
    cps_max_chars_fallback: 50,
    unknown_ratio_warn_percent: 15,
    group_max_distance_lines: 50,
    group_max_errors: 30,
    prompt_max_groups: 3,
    max_retries: 2,
    context_speaker_errors: 8,
    context_chinese_leak: 3,
    context_cps_exceeded: 3,
    context_empty: 5,
    context_default: 5,
    review_batch_size: 80,
    review_context_lines: 8,
  }
}

export function loadSimpleConfig(): SimpleConfig {
  try {
    const raw = localStorage.getItem(STORAGE_KEY)
    if (raw) {
      const parsed = JSON.parse(raw)
      return { ...defaultSimpleConfig(), ...parsed }
    }
  } catch {}
  return defaultSimpleConfig()
}

export function saveSimpleConfig(cfg: SimpleConfig) {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg))
  } catch {}
}

// ─── ConfigPanel component ──────────────────────────────────────────────────

interface Props {
  initialConfig?: SimpleConfig
  onClose: () => void
  onSave: (config: SimpleConfig) => void
}

type ConfigTab = 'models' | 'batch' | 'review'

export default function ConfigPanel({ initialConfig, onClose, onSave }: Props) {
  const [config, setConfig] = useState<SimpleConfig>(initialConfig || loadSimpleConfig())
  const [activeTab, setActiveTab] = useState<ConfigTab>('models')
  const [savedTick, setSavedTick] = useState(0)

  // ESC to close
  useEffect(() => {
    const handler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') onClose()
    }
    document.addEventListener('keydown', handler)
    return () => document.removeEventListener('keydown', handler)
  }, [onClose])

  function handleSave() {
    saveSimpleConfig(config)
    onSave(config)
    setSavedTick(t => t + 1)
    setTimeout(() => onClose(), 400)
  }

  function handleReset() {
    if (confirm('Reset toàn bộ cấu hình về mặc định?')) {
      setConfig(defaultSimpleConfig())
    }
  }

  const updateConfig = <K extends keyof SimpleConfig>(key: K, value: SimpleConfig[K]) => {
    setConfig(prev => ({ ...prev, [key]: value }))
  }

  const updateTask = (key: TaskKey, patch: Partial<SimpleConfig['tasks'][TaskKey]>) => {
    setConfig(prev => ({
      ...prev,
      tasks: { ...prev.tasks, [key]: { ...prev.tasks[key], ...patch } },
    }))
  }

  const updateApiKey = (provider: Provider, value: string) => {
    setConfig(prev => ({
      ...prev,
      api_keys: { ...prev.api_keys, [provider]: value },
    }))
  }

  return (
    <div className="fixed inset-0 z-50 bg-zinc-900/50 backdrop-blur-sm flex items-center justify-center p-4">
      <div className="bg-white dark:bg-zinc-900 rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col border border-zinc-200 dark:border-zinc-800">

        {/* Header */}
        <div className="flex items-center gap-3 px-5 py-3.5 border-b border-zinc-200 dark:border-zinc-800">
          <h2 className="text-base font-semibold text-zinc-900 dark:text-zinc-100">
            Cấu hình pipeline
          </h2>
          <span className="text-xs text-zinc-500 dark:text-zinc-400">
            API keys, models, batch size, repair groups...
          </span>
          <div className="flex-1" />
          <button
            onClick={onClose}
            className="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 text-lg leading-none px-2"
            aria-label="Đóng"
          >
            ✕
          </button>
        </div>

        {/* Tabs */}
        <div className="flex items-stretch gap-1 px-5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30">
          {([
            { key: 'models',  num: '1', label: 'API & Models' },
            { key: 'batch',   num: '2', label: 'Batch dịch' },
            { key: 'review',  num: '3', label: 'Review' },
          ] as { key: ConfigTab; num: string; label: string }[]).map(tab => (
            <button
              key={tab.key}
              onClick={() => setActiveTab(tab.key)}
              className={`flex items-center gap-2 px-3 py-2.5 text-[13px] font-medium border-b-2 -mb-px transition-colors ${
                activeTab === tab.key
                  ? 'border-blue-600 text-zinc-900 dark:text-zinc-100'
                  : 'border-transparent text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200'
              }`}
            >
              <span className={`font-mono text-[11px] px-1.5 py-0.5 rounded ${
                activeTab === tab.key
                  ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300'
                  : 'bg-zinc-200 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400'
              }`}>
                {tab.num}
              </span>
              {tab.label}
            </button>
          ))}
        </div>

        {/* Body */}
        <div className="flex-1 overflow-y-auto px-5 py-4">
          {activeTab === 'models' && (
            <ModelsTab
              config={config}
              onUpdateApiKey={updateApiKey}
              onUpdateTask={updateTask}
            />
          )}
          {activeTab === 'batch' && (
            <BatchTab config={config} onUpdate={updateConfig} />
          )}
          {activeTab === 'review' && (
            <ReviewConfigTab config={config} onUpdate={updateConfig} />
          )}
        </div>

        {/* Footer */}
        <div className="flex items-center gap-2 px-5 py-3 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30">
          <button onClick={handleReset} className="btn text-zinc-500">
            ↻ Reset mặc định
          </button>
          <div className="flex-1" />
          {savedTick > 0 && (
            <span className="text-[12px] text-emerald-600 dark:text-emerald-400 mr-1">
              ✓ Đã lưu
            </span>
          )}
          <button onClick={onClose} className="btn">Hủy</button>
          <button onClick={handleSave} className="btn-primary">💾 Lưu cấu hình</button>
        </div>
      </div>
    </div>
  )
}

// ─── Tab 1 — API Keys & Models ─────────────────────────────────────────────

function ModelsTab({
  config, onUpdateApiKey, onUpdateTask,
}: {
  config: SimpleConfig
  onUpdateApiKey: (provider: Provider, value: string) => void
  onUpdateTask: (key: TaskKey, patch: Partial<SimpleConfig['tasks'][TaskKey]>) => void
}) {
  const [showKey, setShowKey] = useState(false)

  return (
    <div className="space-y-5">
      {/* API Keys */}
      <Section
        title="API Keys"
        desc="Lưu local trên máy bạn (localStorage). Không upload lên server."
      >
        <div className="space-y-2">
          {(['gemini', 'openai', 'deepseek'] as Provider[]).map(p => (
            <div key={p} className="flex items-center gap-3">
              <label className="w-32 text-[12px] font-medium text-zinc-700 dark:text-zinc-300 shrink-0">
                {PROVIDER_LABELS[p]}
              </label>
              <input
                type={showKey ? 'text' : 'password'}
                value={config.api_keys[p]}
                onChange={e => onUpdateApiKey(p, e.target.value)}
                placeholder={`${PROVIDER_LABELS[p]} API key...`}
                className="input flex-1 font-mono text-[12px]"
              />
              <span className="text-[11px] text-zinc-400 font-mono">
                {config.api_keys[p] ? `${config.api_keys[p].length} ký tự` : '—'}
              </span>
            </div>
          ))}
          <label className="flex items-center gap-2 text-[12px] text-zinc-600 dark:text-zinc-400 mt-2">
            <input
              type="checkbox"
              checked={showKey}
              onChange={e => setShowKey(e.target.checked)}
              className="rounded"
            />
            Hiện key
          </label>
        </div>
      </Section>

      {/* Task models */}
      <Section
        title="Model cho từng task"
        desc="Chọn provider + model riêng cho từng task. Bible & Translate nên dùng model mạnh. QA model nhẹ là đủ."
      >
        <div className="space-y-3">
          {(['bible', 'translate', 'qa', 'retranslate'] as TaskKey[]).map(taskKey => (
            <TaskModelRow
              key={taskKey}
              taskKey={taskKey}
              task={config.tasks[taskKey]}
              onUpdate={(patch) => onUpdateTask(taskKey, patch)}
            />
          ))}
        </div>
      </Section>
    </div>
  )
}

function TaskModelRow({
  taskKey, task, onUpdate,
}: {
  taskKey: TaskKey
  task: SimpleConfig['tasks'][TaskKey]
  onUpdate: (patch: Partial<SimpleConfig['tasks'][TaskKey]>) => void
}) {
  const meta = TASK_LABELS[taskKey]
  const models = MODELS[task.provider]
  const selectedModel = models.find(m => m.id === task.model)

  // Khi đổi provider, reset model về model đầu tiên của provider mới
  function handleChangeProvider(p: Provider) {
    onUpdate({
      provider: p,
      model: MODELS[p][0].id,
    })
  }

  return (
    <div className="border border-zinc-200 dark:border-zinc-800 rounded-lg p-3 bg-zinc-50/30 dark:bg-zinc-900/30">
      <div className="flex items-start gap-3 mb-3">
        <div className="flex-1">
          <div className="text-[13px] font-semibold text-zinc-900 dark:text-zinc-100">
            {meta.title}
          </div>
          <div className="text-[11.5px] text-zinc-500 dark:text-zinc-400 mt-0.5 leading-snug">
            {meta.desc}
          </div>
        </div>
        {selectedModel && (
          <div className="text-right text-[11px] font-mono text-zinc-500 dark:text-zinc-400 shrink-0">
            <div>${selectedModel.price_in_per_1m_usd.toFixed(2)} / ${selectedModel.price_out_per_1m_usd.toFixed(2)}</div>
            <div className="text-[10px] text-zinc-400">in / out per 1M tok</div>
          </div>
        )}
      </div>

      <div className="grid grid-cols-[1fr_2fr_auto] gap-2 items-center">
        {/* Provider */}
        <select
          value={task.provider}
          onChange={e => handleChangeProvider(e.target.value as Provider)}
          className="input text-[12px]"
        >
          {(['gemini', 'openai', 'deepseek'] as Provider[]).map(p => (
            <option key={p} value={p}>{PROVIDER_LABELS[p]}</option>
          ))}
        </select>

        {/* Model */}
        <select
          value={task.model}
          onChange={e => onUpdate({ model: e.target.value })}
          className="input text-[12px]"
        >
          {models.map(m => (
            <option key={m.id} value={m.id}>
              {m.label} — {m.desc}
            </option>
          ))}
        </select>

        {/* Thinking */}
        <label className="flex items-center gap-1.5 text-[11.5px] text-zinc-700 dark:text-zinc-300 px-2 cursor-pointer">
          <input
            type="checkbox"
            checked={task.thinking}
            onChange={e => onUpdate({ thinking: e.target.checked })}
            className="rounded"
          />
          <span className="font-medium">Thinking</span>
        </label>
      </div>
    </div>
  )
}

// ─── Tab 2 — Batch & Filter ─────────────────────────────────────────────────

function BatchTab({
  config, onUpdate,
}: {
  config: SimpleConfig
  onUpdate: <K extends keyof SimpleConfig>(key: K, value: SimpleConfig[K]) => void
}) {
  return (
    <div className="space-y-5">
      <Section
        title="Chia batch (Bước II — Dịch)"
        desc="Cắt SRT thành batch ~100 dòng, ưu tiên cắt tại chỗ có khoảng nghỉ ≥3 giây."
      >
        <div className="grid grid-cols-2 gap-x-6 gap-y-3">
          <NumberInput
            label="Batch size mục tiêu"
            value={config.batch_size_target}
            onChange={v => onUpdate('batch_size_target', v)}
            min={20} max={500} step={10}
            hint="Số dòng cho mỗi batch (target). Nếu không tìm được gap, cắt hard."
          />
          <NumberInput
            label="Batch size tối đa (hard cap)"
            value={config.batch_size_max}
            onChange={v => onUpdate('batch_size_max', v)}
            min={50} max={600} step={10}
            hint="Khi không tìm được khoảng nghỉ ≥ngưỡng, cắt tại đây."
          />
          <NumberInput
            label="Khoảng nghỉ tối thiểu (giây)"
            value={config.gap_threshold_seconds}
            onChange={v => onUpdate('gap_threshold_seconds', v)}
            min={1} max={10} step={0.5}
            hint="Cắt batch tại khoảng nghỉ giữa 2 dòng ≥ giá trị này."
          />
          <NumberInput
            label="Context trước (số dòng)"
            value={config.previous_context_lines}
            onChange={v => onUpdate('previous_context_lines', v)}
            min={0} max={30} step={1}
            hint="Gửi N dòng đã dịch cuối batch trước để giữ continuity."
          />
        </div>
      </Section>

      <Section
        title="Concurrency"
        desc="Normal: tuần tự, dùng context đã dịch (chất lượng tốt). Turbo: song song, dùng context Chinese (nhanh ~5x)."
      >
        <div className="flex items-center gap-4">
          <RadioGroup
            value={config.concurrency_mode}
            onChange={v => onUpdate('concurrency_mode', v as any)}
            options={[
              { value: 'normal', label: 'Normal · tuần tự', desc: 'Dùng context VI' },
              { value: 'turbo',  label: 'Turbo · song song', desc: `${config.turbo_concurrency}x, context ZH` },
            ]}
          />
          {config.concurrency_mode === 'turbo' && (
            <NumberInput
              label="Số batch song song"
              value={config.turbo_concurrency}
              onChange={v => onUpdate('turbo_concurrency', v)}
              min={2} max={10} step={1}
              compact
            />
          )}
        </div>
      </Section>

      <Section
        title="Lọc lỗi (Bước III)"
        desc="Code-based validation sau mỗi batch. Không dùng AI."
      >
        <div className="grid grid-cols-2 gap-x-6 gap-y-3">
          <NumberInput
            label="CPS tối đa"
            value={config.cps_max}
            onChange={v => onUpdate('cps_max', v)}
            min={10} max={50} step={1}
            hint="Characters per second. >22 là khó đọc, >30 là rất khó."
          />
          <NumberInput
            label="Char fallback nếu không tính được CPS"
            value={config.cps_max_chars_fallback}
            onChange={v => onUpdate('cps_max_chars_fallback', v)}
            min={20} max={100} step={5}
            hint="Nếu thiếu thời lượng, dùng số ký tự thay thế."
          />
          <NumberInput
            label="UNKNOWN ratio warning (%)"
            value={config.unknown_ratio_warn_percent}
            onChange={v => onUpdate('unknown_ratio_warn_percent', v)}
            min={5} max={30} step={1}
            hint="Cảnh báo nếu % dòng có speaker = UNKNOWN vượt mức này."
          />
        </div>
      </Section>
    </div>
  )
}

// ─── Tab 3 — Review & Repair ────────────────────────────────────────────────

function ReviewConfigTab({
  config, onUpdate,
}: {
  config: SimpleConfig
  onUpdate: <K extends keyof SimpleConfig>(key: K, value: SimpleConfig[K]) => void
}) {
  return (
    <div className="space-y-5">
      <Section
        title="AI Review bản dịch (Bước IV)"
        desc="Chia bản dịch thành các batch để AI rà soát lại xưng hô, speaker, câu từ. AI chỉ trả về dòng cần sửa."
      >
        <div className="grid grid-cols-2 gap-x-6 gap-y-3">
          <NumberInput
            label="Số dòng mỗi review batch"
            value={config.review_batch_size}
            onChange={v => onUpdate('review_batch_size', v)}
            min={20} max={300} step={10}
            hint="Mỗi batch gửi AI 1 lần. Nhỏ hơn batch dịch để AI soi kỹ hơn."
          />
          <NumberInput
            label="Context trước/sau (số dòng)"
            value={config.review_context_lines}
            onChange={v => onUpdate('review_context_lines', v)}
            min={0} max={20} step={1}
            hint="Số dòng ngữ cảnh gửi kèm để AI hiểu mạch hội thoại."
          />
        </div>
      </Section>

      <div className="surface-card p-3 text-[12px] text-zinc-600 dark:text-zinc-400 leading-relaxed">
        💡 AI review dùng model của task <b>"qa"</b> (cấu hình ở tab "API &amp; Models").
        Khuyên dùng <b>gpt-4o-mini</b> (rẻ, nhanh) hoặc model mạnh hơn (gpt-5-mini) để
        review chất lượng cao. Sau khi đổi config, vào tab Review bấm <b>"↻ Rebuild"</b>
        để chia lại batch.
      </div>
    </div>
  )
}

// ─── Form primitives ────────────────────────────────────────────────────────

function Section({
  title, desc, children,
}: {
  title: string
  desc?: string
  children: React.ReactNode
}) {
  return (
    <div>
      <div className="mb-3">
        <h3 className="text-[13px] font-semibold text-zinc-900 dark:text-zinc-100">
          {title}
        </h3>
        {desc && (
          <p className="text-[12px] text-zinc-500 dark:text-zinc-400 mt-0.5 leading-snug max-w-2xl">
            {desc}
          </p>
        )}
      </div>
      {children}
    </div>
  )
}

function NumberInput({
  label, value, onChange, min, max, step, hint, compact,
}: {
  label: string
  value: number
  onChange: (v: number) => void
  min?: number
  max?: number
  step?: number
  hint?: string
  compact?: boolean
}) {
  return (
    <div className={compact ? 'flex items-center gap-2' : ''}>
      <label className="block text-[12px] font-medium text-zinc-700 dark:text-zinc-300 mb-1">
        {label}
      </label>
      <input
        type="number"
        value={value}
        onChange={e => onChange(parseFloat(e.target.value) || 0)}
        min={min} max={max} step={step}
        className={`input text-[13px] font-mono ${compact ? 'w-20' : 'w-full'}`}
      />
      {hint && !compact && (
        <p className="text-[11px] text-zinc-500 dark:text-zinc-500 mt-1 leading-snug">
          {hint}
        </p>
      )}
    </div>
  )
}

function RadioGroup({
  value, onChange, options,
}: {
  value: string
  onChange: (v: string) => void
  options: { value: string; label: string; desc?: string }[]
}) {
  return (
    <div className="flex gap-2">
      {options.map(opt => (
        <button
          key={opt.value}
          onClick={() => onChange(opt.value)}
          className={`px-3 py-2 rounded-lg border text-left transition-all min-w-[180px] ${
            value === opt.value
              ? 'border-blue-500 bg-blue-50 dark:bg-blue-900/30 dark:border-blue-700'
              : 'border-zinc-200 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800'
          }`}
        >
          <div className="text-[13px] font-medium text-zinc-900 dark:text-zinc-100">
            {opt.label}
          </div>
          {opt.desc && (
            <div className="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
              {opt.desc}
            </div>
          )}
        </button>
      ))}
    </div>
  )
}
