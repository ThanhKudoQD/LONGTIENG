"""
Export job runner — async queue + FFmpeg subprocess + progress.

Design:
  - Singleton task queue (FIFO), 1 worker concurrent
  - User submit job → status='pending' → worker pick → status='running' → status='done'|'error'|'cancelled'
  - Progress parse từ stderr FFmpeg (`-progress pipe:2`)
  - WS broadcast progress mỗi 0.5s
  - Cancel: gửi SIGTERM cho ffmpeg process

Khi server restart, các job 'running'/'pending' sẽ mất context — đánh dấu lại 'error'.
"""
import asyncio
import json
import os
import re
import signal
import time
import shutil
import logging
from pathlib import Path
from typing import Optional
from datetime import datetime

from sqlalchemy.orm import Session
from dubeditor.database import SessionLocal
from dubeditor.models import ExportJob, Project, Subtitle
from dubeditor.routers.ws import broadcast
from .config_types import ExportConfig
from .ffmpeg_builder import build_ffmpeg_command, get_video_info
from .subtitle_gen import build_subtitle_ass

logger = logging.getLogger(__name__)

BASE_DIR = Path(__file__).parent.parent.parent
PROJECTS_DIR = BASE_DIR / "data" / "projects"
EXPORTS_DIR = PROJECTS_DIR / "_exports"
UPLOADS_DIR = PROJECTS_DIR / "_export_uploads"
EXPORTS_DIR.mkdir(parents=True, exist_ok=True)
UPLOADS_DIR.mkdir(parents=True, exist_ok=True)


# ─── Global queue + worker state ──────────────────────────────────────────────

_job_queue: Optional[asyncio.Queue] = None      # lazy init khi worker start
_worker_task: Optional[asyncio.Task] = None
_main_loop: Optional[asyncio.AbstractEventLoop] = None   # event loop chính (lưu khi worker start)
_current_proc: Optional[asyncio.subprocess.Process] = None
_current_job_id: Optional[int] = None
_cancel_flag: bool = False


# ─── Resolve uploads ──────────────────────────────────────────────────────────

def resolve_upload_path(rel_or_url: str) -> Optional[str]:
    """
    Convert FE-relative URL/path → absolute filesystem path.
    Supported forms:
      - "/dub/export_uploads/abc.mp3" → BASE_DIR/data/projects/_export_uploads/abc.mp3
      - "abc.mp3" → UPLOADS_DIR/abc.mp3
      - "data/projects/.../audio/123.wav" (already relative to BASE_DIR)
    """
    if not rel_or_url:
        return None
    s = rel_or_url.strip()
    if os.path.isabs(s) and os.path.exists(s):
        return s
    # Voice TTS audio_path: "/dub/projects/18/audio/123.wav"
    if s.startswith('/dub/projects/'):
        rel = s.replace('/dub/projects/', 'data/projects/', 1)
        p = BASE_DIR / rel
        if p.exists():
            return str(p)
    # Upload via export: "/dub/export_uploads/file.mp3"
    if s.startswith('/dub/export_uploads/'):
        name = s.split('/')[-1]
        p = UPLOADS_DIR / name
        if p.exists():
            return str(p)
    # Bare filename
    p = UPLOADS_DIR / s
    if p.exists():
        return str(p)
    return None


# ─── DB helpers ───────────────────────────────────────────────────────────────

def _update_job(job_id: int, **fields) -> Optional[dict]:
    """Update ExportJob in DB and return dict for broadcast."""
    db = SessionLocal()
    try:
        job = db.query(ExportJob).filter(ExportJob.id == job_id).first()
        if not job:
            return None
        for k, v in fields.items():
            setattr(job, k, v)
        db.commit()
        db.refresh(job)
        return {
            'id': job.id, 'project_id': job.project_id, 'status': job.status,
            'progress': job.progress, 'output_url': job.output_url,
            'error_msg': job.error_msg, 'eta_sec': job.eta_sec,
        }
    finally:
        db.close()


async def _broadcast_progress(project_id: int, job_data: dict):
    """Broadcast progress to WS."""
    try:
        await broadcast(project_id, {
            'type': 'export_progress',
            'job': job_data,
        })
    except Exception as e:
        logger.warning(f"broadcast failed: {e}")


# ─── Submit job ───────────────────────────────────────────────────────────────

def submit_job(project_id: int, config: ExportConfig) -> int:
    """
    Tạo ExportJob record, enqueue → trả job_id.
    """
    db = SessionLocal()
    try:
        job = ExportJob(
            project_id=project_id,
            status='pending',
            progress=0.0,
            config_json=config.model_dump_json(),
        )
        db.add(job)
        db.commit()
        db.refresh(job)
        job_id = job.id
    finally:
        db.close()

    # Enqueue qua main event loop (thread-safe).
    # FastAPI endpoint chạy trong AnyIO worker thread → KHÔNG có current loop ở đây.
    # Phải dùng _main_loop đã lưu lúc start_worker().
    if _main_loop is None or _job_queue is None:
        msg = "Export worker chưa khởi tạo. Hãy restart server."
        logger.error(msg)
        _update_job(job_id, status='error', error_msg=msg)
        return job_id

    try:
        _main_loop.call_soon_threadsafe(_job_queue.put_nowait, job_id)
    except Exception as e:
        logger.error(f"enqueue failed: {e}")
        _update_job(job_id, status='error', error_msg=f'enqueue failed: {e}')

    return job_id


# ─── Cancel ───────────────────────────────────────────────────────────────────

def cancel_job(job_id: int) -> bool:
    """Cancel job. Nếu đang running → kill ffmpeg. Nếu pending → mark cancelled."""
    global _cancel_flag, _current_proc, _current_job_id
    db = SessionLocal()
    try:
        job = db.query(ExportJob).filter(ExportJob.id == job_id).first()
        if not job:
            return False
        if job.status == 'running' and _current_job_id == job_id and _current_proc:
            _cancel_flag = True
            try:
                _current_proc.terminate()
            except Exception:
                pass
            return True
        elif job.status == 'pending':
            job.status = 'cancelled'
            db.commit()
            return True
        return False
    finally:
        db.close()


# ─── Worker loop ──────────────────────────────────────────────────────────────

async def _worker():
    """Process jobs from queue one-by-one."""
    global _current_proc, _current_job_id, _cancel_flag
    logger.info("[ExportWorker] started")
    while True:
        try:
            job_id = await _job_queue.get()
        except Exception as e:
            logger.error(f"[ExportWorker] queue.get failed: {e}")
            await asyncio.sleep(1)
            continue

        # Check job vẫn tồn tại + chưa cancel
        db = SessionLocal()
        try:
            job = db.query(ExportJob).filter(ExportJob.id == job_id).first()
            if not job:
                continue
            if job.status == 'cancelled':
                continue
        finally:
            db.close()

        _current_job_id = job_id
        _cancel_flag = False
        try:
            await _run_job(job_id)
        except Exception as e:
            logger.exception(f"[ExportWorker] job {job_id} crashed")
            data = _update_job(job_id, status='error', error_msg=str(e), finished_at=datetime.utcnow())
            if data:
                # broadcast (best-effort)
                db = SessionLocal()
                try:
                    j = db.query(ExportJob).filter(ExportJob.id == job_id).first()
                    if j:
                        await _broadcast_progress(j.project_id, data)
                finally:
                    db.close()
        finally:
            _current_proc = None
            _current_job_id = None
            _cancel_flag = False


async def _run_job(job_id: int):
    """Process 1 job: build cmd, run ffmpeg, parse progress, save output."""
    global _current_proc, _cancel_flag
    db = SessionLocal()
    project_id = None
    try:
        job = db.query(ExportJob).filter(ExportJob.id == job_id).first()
        if not job:
            return
        project_id = job.project_id
        config = ExportConfig(**json.loads(job.config_json))

        project = db.query(Project).filter(Project.id == project_id).first()
        if not project or not project.video_path:
            raise RuntimeError("Project hoặc video_path không tồn tại")

        # Resolve video_path: project.video_path = "/dub/videos/xxx.mp4"
        # → file ở BASE_DIR / data/projects/_videos/xxx.mp4
        video_name = Path(project.video_path).name
        candidates = [
            BASE_DIR / "data" / "projects" / "_videos" / video_name,
            BASE_DIR / "data" / "videos" / video_name,   # fallback nếu mount khác
        ]
        video_abs = None
        for c in candidates:
            if c.exists():
                video_abs = c
                break
        if not video_abs:
            raise RuntimeError(f"Không tìm thấy file video: {project.video_path}")

        # Voice TTS segments
        subs = db.query(Subtitle).filter(Subtitle.project_id == project_id).all()
        voice_segments = []
        sub_dicts = []
        for s in subs:
            sub_dicts.append({
                'id': s.id,
                'start_time': s.start_time or 0,
                'end_time': s.end_time or 0,
                'text': s.text or '',
            })
            if s.tts_done and s.audio_path and config.audio.voice_enabled:
                audio_abs = resolve_upload_path(s.audio_path)
                if not audio_abs:
                    continue
                # OUTPUT time của sub (sau cắt)
                from .subtitle_gen import map_source_to_output_time
                src_start = (s.start_time or 0) + (s.audio_offset or 0)
                out_start = map_source_to_output_time(src_start, config.clips)
                if out_start is None:
                    continue
                duration = (s.wav_duration or (s.end_time - s.start_time)) or 1.0
                voice_segments.append({
                    'id': s.id,
                    'start': out_start,
                    'end': out_start + duration,
                    'audio_path': s.audio_path,
                    'audio_path_resolved': audio_abs,
                })

        # Resolve BGM paths
        for tr in config.audio.tracks:
            p = resolve_upload_path(tr.file_url or tr.file_path)
            if p:
                setattr(tr, '_resolved_path', p)

        # Resolve watermark image paths
        for wm in config.watermarks:
            if wm.type == 'image':
                p = resolve_upload_path(wm.image_url or wm.image_path)
                if p:
                    setattr(wm, '_resolved_path', p)

        # Get video info
        video_info = get_video_info(str(video_abs))

        # Output path
        ext = 'mp4' if config.output.format == 'mp4' else config.output.format
        output_filename = f"export_{project_id}_{job_id}.{ext}"
        output_abs = EXPORTS_DIR / output_filename
        if output_abs.exists():
            output_abs.unlink()

        # Build ASS subtitle if enabled
        ass_path = None
        if config.subtitle_style.enabled and sub_dicts:
            from .ffmpeg_builder import compute_output_dims
            out_w, out_h = compute_output_dims(config.output, video_info['width'], video_info['height'])
            ass_content = build_subtitle_ass(
                sub_dicts, config.subtitle_style, config.clips,
                config.padding, out_w, out_h,
            )
            ass_file = EXPORTS_DIR / f"sub_{project_id}_{job_id}.ass"
            ass_file.write_text(ass_content, encoding='utf-8')
            ass_path = str(ass_file)

        # Build command
        cmd, meta = build_ffmpeg_command(
            video_path=str(video_abs),
            output_path=str(output_abs),
            config=config,
            ass_path=ass_path,
            voice_segments=voice_segments,
            video_info=video_info,
        )
        output_duration = meta['output_duration']

        logger.info(f"[ExportJob {job_id}] starting ffmpeg, output={output_filename}, duration={output_duration:.1f}s")
        logger.debug(f"[ExportJob {job_id}] cmd: {' '.join(cmd)}")

        # Update status
        data = _update_job(job_id, status='running', started_at=datetime.utcnow(), progress=0.0)
        if data:
            await _broadcast_progress(project_id, data)
    finally:
        db.close()

    # ─── Run FFmpeg subprocess ────────────────────────────────────────────────
    start_time = time.time()

    proc = await asyncio.create_subprocess_exec(
        *cmd,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    _current_proc = proc

    # Parse stderr for progress
    progress_re = re.compile(r'out_time_ms=(\d+)')
    last_broadcast = 0.0

    stderr_buffer: list = []
    try:
        async for line_bytes in proc.stderr:
            line = line_bytes.decode('utf-8', errors='replace')
            stderr_buffer.append(line)
            if len(stderr_buffer) > 200:
                stderr_buffer = stderr_buffer[-200:]

            m = progress_re.search(line)
            if m:
                out_time_ms = int(m.group(1))
                out_time_sec = out_time_ms / 1_000_000.0
                if output_duration > 0:
                    pct = min(99.5, (out_time_sec / output_duration) * 100)
                else:
                    pct = 0
                now = time.time()
                # Broadcast mỗi 0.5s
                if now - last_broadcast > 0.5:
                    last_broadcast = now
                    elapsed = now - start_time
                    eta = (elapsed / max(0.01, pct)) * (100 - pct) if pct > 1 else 0
                    data = _update_job(job_id, progress=pct, eta_sec=eta)
                    if data:
                        await _broadcast_progress(project_id, data)
            if _cancel_flag:
                break
    except Exception as e:
        logger.exception(f"[ExportJob {job_id}] stderr read failed")

    # Wait done
    try:
        await proc.wait()
    except Exception:
        pass

    # ─── Result ──────────────────────────────────────────────────────────────
    if _cancel_flag:
        if output_abs.exists():
            output_abs.unlink()
        data = _update_job(job_id, status='cancelled', finished_at=datetime.utcnow())
    elif proc.returncode == 0 and output_abs.exists():
        size = output_abs.stat().st_size
        out_url = f"/dub/exports/{output_filename}"
        data = _update_job(job_id,
            status='done', progress=100.0,
            output_path=str(output_abs), output_url=out_url, output_size=size,
            finished_at=datetime.utcnow(), eta_sec=0,
        )
    else:
        # Error — extract last lines of stderr
        err_text = ''.join(stderr_buffer[-50:])
        logger.error(f"[ExportJob {job_id}] FAILED rc={proc.returncode}\nstderr tail:\n{err_text}")
        data = _update_job(job_id,
            status='error',
            error_msg=f"FFmpeg exit code {proc.returncode}. " + (err_text[-500:] if err_text else ''),
            finished_at=datetime.utcnow(),
        )

    if data and project_id:
        await _broadcast_progress(project_id, data)


# ─── Start worker (called from app startup) ───────────────────────────────────

def start_worker(loop: asyncio.AbstractEventLoop):
    """Start background worker. Phải gọi từ async context (lifespan)."""
    global _worker_task, _main_loop, _job_queue
    if _worker_task is not None and not _worker_task.done():
        return
    _main_loop = loop
    # Init queue gắn vào loop hiện tại
    if _job_queue is None:
        _job_queue = asyncio.Queue()
    _worker_task = loop.create_task(_worker())
    logger.info("[ExportService] worker task created, main loop locked")


# ─── Mark stuck jobs on startup ───────────────────────────────────────────────

def mark_stuck_jobs():
    """On server restart, mark any 'running' jobs as error (orphaned)."""
    db = SessionLocal()
    try:
        stuck = db.query(ExportJob).filter(ExportJob.status.in_(['running', 'pending'])).all()
        for j in stuck:
            j.status = 'error'
            j.error_msg = 'Server restarted while job was running/pending'
            j.finished_at = datetime.utcnow()
        if stuck:
            db.commit()
            logger.info(f"[ExportService] marked {len(stuck)} stuck jobs as error")
    finally:
        db.close()
